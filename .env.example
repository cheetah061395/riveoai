# Early-access signups. Both come from the Google Form that owns the list.
# Prefill the form once, click "Get pre-filled link", and read the values off
# the URL it gives you: the form id sits in the path, the field id is the
# entry.NNNN query parameter.
GOOGLE_FORM_ACTION_URL="https://docs.google.com/forms/d/e/<FORM_ID>/formResponse"
GOOGLE_FORM_EMAIL_ENTRY="entry.<FIELD_ID>"
